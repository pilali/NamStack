@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix bufs:  <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .

<urn:pilali:NamStackMOD#model>
	a lv2:Parameter ;
	mod:fileTypes "nam,nammodel,json,aidax,aidadspmodel" ;
	rdfs:label "Neural Model" ;
	rdfs:range atom:Path .

<urn:pilali:NamStackMOD#ir1>
	a lv2:Parameter ;
	mod:fileTypes "cabsim,ir,wav" ;
	rdfs:label "IR 1" ;
	rdfs:range atom:Path .

<urn:pilali:NamStackMOD#ir2>
	a lv2:Parameter ;
	mod:fileTypes "cabsim,ir,wav" ;
	rdfs:label "IR 2" ;
	rdfs:range atom:Path .

<urn:pilali:NamStackMOD#ir3>
	a lv2:Parameter ;
	mod:fileTypes "cabsim,ir,wav" ;
	rdfs:label "IR 3" ;
	rdfs:range atom:Path .

<urn:pilali:NamStackMOD#ir4>
	a lv2:Parameter ;
	mod:fileTypes "cabsim,ir,wav" ;
	rdfs:label "IR 4" ;
	rdfs:range atom:Path .

<urn:pilali:NamStackMOD>
	a lv2:Plugin , lv2:SimulatorPlugin , doap:Project ;
	doap:name "NamStack" ;
	doap:license <http://opensource.org/licenses/gpl-3-0> ;
	lv2:minorVersion 1 ;
	lv2:microVersion 0 ;
	mod:brand "Pilali" ;
	mod:label "NamStack" ;

	doap:maintainer [
		foaf:name "Pilali" ;
		foaf:homepage <https://github.com/pilali/NamStack> ;
	] ;

	lv2:requiredFeature urid:map , work:schedule ;
	lv2:optionalFeature lv2:hardRTCapable , opts:options , state:threadSafeRestore ;
	lv2:extensionData work:interface , state:interface , opts:interface ;
	opts:supportedOption bufs:maxBlockLength ;

	patch:writable <urn:pilali:NamStackMOD#model> ,
	               <urn:pilali:NamStackMOD#ir1> ,
	               <urn:pilali:NamStackMOD#ir2> ,
	               <urn:pilali:NamStackMOD#ir3> ,
	               <urn:pilali:NamStackMOD#ir4> ;

	rdfs:comment """
Neural amp modeler (NAM and AIDA-X / RTNeural models) with switchable classic
tone stacks (Fender, Marshall, Mesa Boogie, Vox, Ampeg, Soldano), a 4-slot IR
mixer with per-IR level and pan, and an ADT-style stereo image ("spread") at
the end of the chain.
""" ;

	lv2:port [
		a atom:AtomPort , lv2:InputPort ;
		atom:bufferType atom:Sequence ;
		atom:supports patch:Message ;
		lv2:designation lv2:control ;
		lv2:index 0 ;
		lv2:symbol "control" ;
		lv2:name "Control" ;
	] , [
		a atom:AtomPort , lv2:OutputPort ;
		atom:bufferType atom:Sequence ;
		atom:supports patch:Message ;
		lv2:designation lv2:control ;
		lv2:index 1 ;
		lv2:symbol "notify" ;
		lv2:name "Notify" ;
	] , [
		a lv2:InputPort , lv2:AudioPort ;
		lv2:index 2 ;
		lv2:symbol "audio_in" ;
		lv2:name "Audio In" ;
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 3 ;
		lv2:symbol "audio_out_l" ;
		lv2:name "Audio Out L" ;
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 4 ;
		lv2:symbol "audio_out_r" ;
		lv2:name "Audio Out R" ;
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 5 ;
		lv2:symbol "latency" ;
		lv2:name "Latency" ;
		lv2:designation lv2:latency ;
		lv2:portProperty lv2:reportsLatency , lv2:integer , pprop:notOnGUI ;
		units:unit units:frame ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 6 ;
		lv2:symbol "in_gain" ;
		lv2:name "Input Gain" ;
		lv2:default 0.0 ;
		lv2:minimum -24.0 ;
		lv2:maximum 24.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 7 ;
		lv2:symbol "aida_p1" ;
		lv2:name "Model Param 1" ;
		lv2:default 0.5 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 8 ;
		lv2:symbol "aida_p2" ;
		lv2:name "Model Param 2" ;
		lv2:default 0.5 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 9 ;
		lv2:symbol "ts_model" ;
		lv2:name "Tone Stack" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 9 ;
		lv2:portProperty lv2:integer , lv2:enumeration ;
		lv2:scalePoint [ rdfs:label "Bypass" ; rdf:value 0 ] ,
		               [ rdfs:label "Fender Bassman 5F6-A" ; rdf:value 1 ] ,
		               [ rdfs:label "Fender Twin Reverb" ; rdf:value 2 ] ,
		               [ rdfs:label "Fender Princeton" ; rdf:value 3 ] ,
		               [ rdfs:label "Marshall JCM800 2203" ; rdf:value 4 ] ,
		               [ rdfs:label "Mesa Boogie Mark" ; rdf:value 5 ] ,
		               [ rdfs:label "Vox AC30 Top Boost" ; rdf:value 6 ] ,
		               [ rdfs:label "Ampeg SVT" ; rdf:value 7 ] ,
		               [ rdfs:label "Soldano SLO-100" ; rdf:value 8 ] ,
		               [ rdfs:label "Hiwatt DR103" ; rdf:value 9 ] ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 10 ;
		lv2:symbol "ts_position" ;
		lv2:name "Tone Stack Position" ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:enumeration ;
		lv2:scalePoint [ rdfs:label "Pre" ; rdf:value 0 ] ,
		               [ rdfs:label "Post" ; rdf:value 1 ] ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 11 ;
		lv2:symbol "ts_bass" ;
		lv2:name "Bass" ;
		lv2:default 0.5 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 12 ;
		lv2:symbol "ts_mid" ;
		lv2:name "Middle" ;
		lv2:default 0.5 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 13 ;
		lv2:symbol "ts_treble" ;
		lv2:name "Treble" ;
		lv2:default 0.5 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 14 ;
		lv2:symbol "ir1_on" ;
		lv2:name "IR 1 On" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 15 ;
		lv2:symbol "ir1_gain" ;
		lv2:name "IR 1 Level" ;
		lv2:default 0.0 ;
		lv2:minimum -40.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 16 ;
		lv2:symbol "ir1_pan" ;
		lv2:name "IR 1 Pan" ;
		lv2:default 0.0 ;
		lv2:minimum -1.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 17 ;
		lv2:symbol "ir2_on" ;
		lv2:name "IR 2 On" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 18 ;
		lv2:symbol "ir2_gain" ;
		lv2:name "IR 2 Level" ;
		lv2:default 0.0 ;
		lv2:minimum -40.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 19 ;
		lv2:symbol "ir2_pan" ;
		lv2:name "IR 2 Pan" ;
		lv2:default 0.0 ;
		lv2:minimum -1.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 20 ;
		lv2:symbol "ir3_on" ;
		lv2:name "IR 3 On" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 21 ;
		lv2:symbol "ir3_gain" ;
		lv2:name "IR 3 Level" ;
		lv2:default 0.0 ;
		lv2:minimum -40.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 22 ;
		lv2:symbol "ir3_pan" ;
		lv2:name "IR 3 Pan" ;
		lv2:default 0.0 ;
		lv2:minimum -1.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 23 ;
		lv2:symbol "ir4_on" ;
		lv2:name "IR 4 On" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 24 ;
		lv2:symbol "ir4_gain" ;
		lv2:name "IR 4 Level" ;
		lv2:default 0.0 ;
		lv2:minimum -40.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 25 ;
		lv2:symbol "ir4_pan" ;
		lv2:name "IR 4 Pan" ;
		lv2:default 0.0 ;
		lv2:minimum -1.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 26 ;
		lv2:symbol "spr_on" ;
		lv2:name "Spread On" ;
		rdfs:comment "ADT-style stereo image: one channel keeps the performance, the other gets a slightly late, wobbling copy. Replaces the pitch-shift doubler that used to sit on ports 26-31." ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 27 ;
		lv2:symbol "spr_offset" ;
		lv2:name "Spread Offset" ;
		rdfs:comment "Signed delay of the doubled side. The sign picks which channel is late (positive = right), the magnitude sets the delay; the centre is exactly dual mono." ;
		lv2:default 15.0 ;
		lv2:minimum -24.0 ;
		lv2:maximum 24.0 ;
		units:unit units:ms ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 28 ;
		lv2:symbol "spr_wobble" ;
		lv2:name "Spread Wobble" ;
		rdfs:comment "Depth of the random-walk drift of the delay time, up to +-1.2 ms. Absolute, not relative to the offset." ;
		lv2:default 0.25 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 29 ;
		lv2:symbol "spr_wobble_on" ;
		lv2:name "Spread Wobble On" ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 30 ;
		lv2:symbol "spr_xover" ;
		lv2:name "Spread Crossover" ;
		rdfs:comment "Everything below this stays out of the delay, so the lows fold down to mono cleanly." ;
		lv2:default 130.0 ;
		lv2:minimum 32.5 ;
		lv2:maximum 520.0 ;
		lv2:portProperty pprop:logarithmic ;
		units:unit units:hz ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 31 ;
		lv2:symbol "spr_xover_on" ;
		lv2:name "Spread Crossover On" ;
		rdfs:comment "Off: the whole band is doubled -- maximum width, mono safety traded away." ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 32 ;
		lv2:symbol "out_gain" ;
		lv2:name "Output Gain" ;
		lv2:default 0.0 ;
		lv2:minimum -24.0 ;
		lv2:maximum 24.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 33 ;
		lv2:symbol "quality" ;
		lv2:name "Model Quality" ;
		rdfs:comment "Quality vs CPU trade-off for slimmable NAM models (A2). No effect on other models." ;
		lv2:default 1.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 34 ;
		lv2:symbol "ts_on" ;
		lv2:name "Tone Stack On" ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 35 ;
		lv2:symbol "geq_on" ;
		lv2:name "Graphic EQ On" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 36 ;
		lv2:symbol "geq_position" ;
		lv2:name "Graphic EQ Position" ;
		rdfs:comment "Side of the neural model the graphic EQ sits on. When it lands on the same side as the tone stack, it comes after it." ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:enumeration ;
		lv2:scalePoint [ rdfs:label "Pre" ; rdf:value 0 ] ,
		               [ rdfs:label "Post" ; rdf:value 1 ] ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 37 ;
		lv2:symbol "geq_80" ;
		lv2:name "EQ 80 Hz" ;
		lv2:default 0.0 ;
		lv2:minimum -12.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 38 ;
		lv2:symbol "geq_240" ;
		lv2:name "EQ 240 Hz" ;
		lv2:default 0.0 ;
		lv2:minimum -12.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 39 ;
		lv2:symbol "geq_750" ;
		lv2:name "EQ 750 Hz" ;
		lv2:default 0.0 ;
		lv2:minimum -12.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 40 ;
		lv2:symbol "geq_2200" ;
		lv2:name "EQ 2200 Hz" ;
		lv2:default 0.0 ;
		lv2:minimum -12.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 41 ;
		lv2:symbol "geq_6600" ;
		lv2:name "EQ 6600 Hz" ;
		lv2:default 0.0 ;
		lv2:minimum -12.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 42 ;
		lv2:symbol "spr_diffuse_on" ;
		lv2:name "Spread Diffuse On" ;
		rdfs:comment "Allpass cascade on the late side. Off leaves it a pure delay: more coherent, more comb-like on a mono sum." ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 43 ;
		lv2:symbol "ts_comp" ;
		lv2:name "Tone Stack Level Comp" ;
		rdfs:comment "Makes up the passive stack's insertion loss so every model reads 0 dB with the three knobs at noon. Off = the bare circuit, which loses 4.6 to 13.1 dB depending on the model." ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled ;
	] .
